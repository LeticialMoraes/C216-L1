# --- Ligação PostgreSQL (usa um dos modos) ---

# Modo 1: URL (password com # ? & : @ tem de ir codificada em URL, ex.: # → %23)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitstock

# Modo 2 (útil se a password tiver # ? etc.): comente DATABASE_URL acima e descomente:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=a_sua_password
# PGDATABASE=fitstock

# API
PORT=3000

# CORS — URL do Vite em desenvolvimento
FRONTEND_ORIGIN=http://localhost:5173
